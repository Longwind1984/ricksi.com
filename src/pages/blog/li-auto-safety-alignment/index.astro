      var NODE_GUIDE = {
        envelope:{english:"Request Envelope & Version Snapshot",oneLine:"在任何判断前冻结请求、渠道和活动版本，使一次回答可重放、可归责。",forms:"Schema 校验、请求 ID、版本 pin、last-known-good manifest。",practice:"版本化运行时与 trace 是企业治理的通用工程做法。",tradeoff:"增加少量校验与日志，换取可复现性；版本不全时受限降级。"},
        input_guard:{english:"Input Guard",oneLine:"用确定性规则和高召回检测器识别明确红线，必要时在主模型启动前终止。",forms:"关键词/正则、轻量分类器、输入 Guard Model、并行 Policy checks。",practice:"业界常把确定性 blocking 与概率型并行检测分开。",tradeoff:"硬终止范围必须窄；不确定信号只升级检查，避免高误拒。"},
        semantic:{english:"Semantic & Entity Parsing",oneLine:"结构化用户真实意图、候选实体、硬约束和待证主张，避免任何控制环节静默替换问题。",forms:"NER、实体链接、多标签分类、结构化 LLM、slot extraction。",practice:"语义解析是风险路由与事实检索共享的前置能力。",tradeoff:"多一次轻量解析成本，换取问题忠实；置信不足时澄清。"},
        router:{english:"Multi-level Risk Router",oneLine:"输出多维风险向量，决定在哪里拦截、注入什么约束和采用什么验证预算；它不拥有硬阻断权。",forms:"决策表、校准分类器、多轴风险向量、policy-conditioned router。",practice:"多阶段 rails 通常按输入、检索、执行与输出分面，本方案再用 R0–R4 编译调用路径。",tradeoff:"不能压成单一安全分；多风险取最高保障与检查并集，硬动作仍由已签 Policy 决定。"},
        preblock:{english:"Pre-generation Stop",oneLine:"命中已签发硬规则或关键签名失效时，不启动自由生成，直接返回固定安全替代。",forms:"确定性 policy action、签名/版本校验、预批准模板。",practice:"高置信硬门可在昂贵模型前 fail fast。",tradeoff:"减少风险暴露和成本，但必须以窄范围、可解释条件控制误杀。"},
        policy:{english:"Policy Resolver",oneLine:"按照权威层级、适用范围和生效版本，解析本次请求唯一可执行的最小政策集合。",forms:"Policy Registry、确定性 resolver、taxonomy classifier、policy reasoner。",practice:"模型可做语义匹配，政策权威与 precedence 应由版本化规则决定。",tradeoff:"要求政策原子化与维护纪律，换取可问责和可回滚。"},
        evidence:{english:"Evidence Ledger",oneLine:"逐主张限定哪些当前事实可以被说、哪些冲突或未知必须披露。",forms:"Claim ledger、Hybrid RAG、freshness rule、NLI/冲突检查。",practice:"检索后 rail 和 contextual grounding 都强调回答必须受证据范围约束。",tradeoff:"逐主张校验更慢，但避免有文档就任意扩写。"},
        grant:{english:"Crisis Grant",oneLine:"只在事件、渠道、版本、签发人和有效期全部匹配时激活临时企业立场。",forms:"签名 artifact、ABAC、状态机、双时钟与撤回开关。",practice:"这是企业授权设计，不是 Guard Model 自主判断。",tradeoff:"授权与事实分离：事实成立不自动授权立场，授权也不能创造事实。"},
        contract:{english:"Response Contract",oneLine:"把问题、政策、证据、授权和必需检查编译成主模型与 Guard 共用的不可变执行合同。",forms:"类型化 schema、确定性合并器、签名/hash、must/may/must-not。",practice:"结构化合同避免 Prompt、Judge 与 Guard 各自解释一套规则。",tradeoff:"增加前置编译，换取一致性；合同仍可能被模型违反，必须独立校验。"},
        injector:{english:"Constraint Context Injection",oneLine:"只把本次允许主张、不确定性、禁止方向和回答结构注入主模型。",forms:"System/developer context、模板、few-shot、constrained decoding。",practice:"约束应按请求最小化，而不是把全量政策塞入 Prompt。",tradeoff:"在覆盖与上下文长度之间取舍；失败时回落到预批准模板。"},
        mainmodel:{english:"Main Model",oneLine:"负责理解、推理、表达和提出显式工具意图；工具完成前不能形成最终候选，也不拥有企业政策、事实、立场或发布权。",forms:"基础模型、结构化输出、可选稳定姿态 LoRA。",practice:"Agent runtime 通常把模型、工具、guardrail 和 runner 分开管理。",tradeoff:"保留通用能力，同时把时变企业决策留在模型外。"},
        behavior_guard:{english:"Observable Intermediate Behavior Guard",oneLine:"检查系统可见的结构化计划、交接和工具意图，不读取或依赖隐藏思维链。",forms:"Typed event validator、plan schema、handoff allowlist、intent classifier。",practice:"Agent runner 可暴露 tool call、handoff 与 stream events；隐藏 CoT 不是可靠安全证据。",tradeoff:"只能治理可观察、将影响下一步的事件，但边界清楚且可验证。"},
        tool_boundary:{english:"Tool I/O Content Boundary",oneLine:"在工具调用前后检查参数与返回，并在所有调用终结、结果净化且来源有效时签出完成证明。",forms:"Tool input/output guardrail、strict schema、allowlist、PII filter、provenance wrapper。",practice:"Tool guardrails 与 execution rails 都覆盖调用前和返回后检查。",tradeoff:"每次往返增加延迟；但只看输入和最终输出会漏掉中间风险。"},
        external_tool_gate:{english:"Deterministic Tool Execution Gate",oneLine:"由工具域自己的权限、车辆状态机和功能安全底线决定动作能否真正执行。",forms:"RBAC/ABAC、capability token、interlock、交易审批或 HITL。",practice:"内容合格与工具可执行是两种资格，必须分开。",tradeoff:"明确接口边界；本方案不把内容对齐伪装成车辆功能安全系统。"},
        stream_buffer:{english:"Risk-adaptive Streaming Buffer",oneLine:"在文本或语音真正暴露给用户前先缓冲送检，以释放延迟换取可控泄漏上界。",forms:"Token/句/全文 buffer、sliding window、kill switch、audio interrupt。",practice:"同步缓冲更安全但更慢；异步检查更快却可能先暴露违规片段。",tradeoff:"R3 完整缓冲，低风险句块级；必须记录决策前已暴露量。"},
        output_guard:{english:"Parallel Output Guards",oneLine:"对候选分项检查安全、隐私、忠实、事实、品牌、授权、合同，并验证工具往返已经完整终结。",forms:"规则、专业 Guard Model、NLI、cross-model Judge、并行 fan-out。",practice:"多项检查可并行降低墙钟时间，但不同模型可能相关共错。",tradeoff:"多数票不能覆盖硬规则、缺失证据、无效授权或未完成工具调用。"},
        aggregator:{english:"Eligibility Aggregator",oneLine:"把检查和必需证明按硬失败优先、必需项全通过的规则合成为唯一发布决策。",forms:"Deterministic decision assembler、reason code、mandatory AND / hard OR。",practice:"这是本方案的决策工程抽象，不是一个平均安全分。",tradeoff:"软分只决定排序或修复，不能抵消硬失败。"},
