        var selected=GRANT_FIELDS[state.grantField];$("#grant-field-detail").innerHTML="<dl><dt>Owner</dt><dd>"+selected.owner+"</dd><dt>Veto / 审批</dt><dd>"+selected.veto+"</dd><dt>系统执行</dt><dd>"+selected.system+"</dd></dl>";
