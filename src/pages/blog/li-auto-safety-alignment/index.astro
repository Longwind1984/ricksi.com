      function renderCrisis() {
        var current=CRISIS_STEPS.find(function(item){return item.id===state.crisisStep;}) || CRISIS_STEPS[0], host=$("#crisis-statebar");host.innerHTML="";
        CRISIS_STEPS.forEach(function(item){var button=document.createElement("button");button.type="button";button.dataset.stepId=item.id;button.setAttribute("aria-pressed",String(item.id===current.id));button.innerHTML="<b>"+item.label+"</b><small>"+item.time+"</small>";button.addEventListener("click",function(){state.crisisStep=item.id;if(item.allowed.indexOf(state.crisisStrategy)<0)state.crisisStrategy=item.defaultStrategy;renderCrisis();});host.appendChild(button);});
        var strategyHost=$("#strategy-tabs");strategyHost.innerHTML="";
        $("#crisis-guidance").textContent="";
        CRISIS_STRATEGIES.forEach(function(item){var allowed=current.allowed.indexOf(item.id)>=0,button=document.createElement("button");button.type="button";button.setAttribute("aria-disabled",String(!allowed));button.setAttribute("aria-pressed",String(item.id===state.crisisStrategy));button.innerHTML=item.label+"<span>"+(allowed?item.sub:"当前事实/授权不足")+"</span>";button.addEventListener("click",function(){
          if(!allowed){var required=CRISIS_STEPS.find(step=>step.allowed.indexOf(item.id)>=0),requiredButton=required&&host.querySelector('[data-step-id="'+required.id+'"]');$("#crisis-guidance").textContent=item.label+"需要先进入 "+(required?required.label:"更高事实状态")+"。请先选择该状态，再切换策略。";if(requiredButton){requiredButton.classList.add("needs-attention");window.setTimeout(function(){requiredButton.classList.remove("needs-attention");},1000);}return;}
          state.crisisStrategy=item.id;renderCrisis();
        });strategyHost.appendChild(button);});
        $("#grant-clock").className="clock"+(current.id==="s0"||current.id==="recovery"?" expired":"");$("#grant-clock").innerHTML="<b>Grant</b><small>"+current.grant+"</small>";
        $("#evidence-clock").className="clock"+(current.id==="s0"||current.id==="recovery"?" expired":"");$("#evidence-clock").innerHTML="<b>Evidence</b><small>"+current.evidence+"</small>";
        $("#response-meta").innerHTML="<div><b>已签事实</b><small>"+current.facts+"</small></div><div><b>策略资格</b><small>"+state.crisisStrategy+" · scope 命中</small></div><div><b>签发责任</b><small>"+current.approval+"</small></div>";
        var paragraphs=(CRISIS_RESPONSES[current.id]&&CRISIS_RESPONSES[current.id][state.crisisStrategy])||CRISIS_RESPONSES[current.id][current.defaultStrategy];
        $("#crisis-response").innerHTML="<strong>"+CRISIS_STRATEGIES.find(function(item){return item.id===state.crisisStrategy;}).label+"完整回复</strong>"+paragraphs.map(function(text){return "<p>"+text+"</p>";}).join("");
      }
