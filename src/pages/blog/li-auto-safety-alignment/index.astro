        var tasks = SWIM_DATA[state.artifact];
        ROLES.forEach(function (role) {
          var roleCell = cell(role.label,"role"); roleCell.innerHTML = role.label + "<small>" + role.power + "</small>"; host.appendChild(roleCell);
          PHASES.forEach(function (_,phaseIndex) {
            var container = cell("","swim-empty");
            tasks.filter(function (task) { return task[0] === role.id && task[1] === phaseIndex; }).forEach(function (task) {
              var button = document.createElement("button"); button.type = "button"; button.className = "swim-task " + task[3]; button.textContent = task[2];
              button.setAttribute("aria-label",role.label + "，" + task[2] + "，" + role.power);
              button.addEventListener("click",function () { openTask(role,task); }); container.appendChild(button);
            });
            host.appendChild(container);
          });
        });
        var captions = {crisis:"Crisis Grant：runtime 签发不等于全局版本发布",policy:"Policy：企业决定价值，PM 转译，Release Owner 发布",evidence:"Evidence：事实签署与企业立场是两种权力",release:"Release Bundle：唯一发布决定建立在类型化审批与评测之上"};
        $("#swim-caption").textContent = captions[state.artifact];
      }
      function cell(text,className) { var div = document.createElement("div"); div.className = className; div.textContent = text; return div; }
      function openTask(role,task) {
        state.focus = document.activeElement; $("#task-dialog-title").textContent = task[2];
        var fields = [["所在泳道",role.label + " · " + role.power],["输入与输出",task[4]],["Responsible",task[5]],["Accountable",task[6]],["Veto / 不可独自决定",task[7]],["超时 fallback",task[8]]];
        $("#task-dialog-body").innerHTML = fields.map(function (field) { return "<div><dt>" + field[0] + "</dt><dd>" + field[1] + "</dd></div>"; }).join("");
        $("#task-dialog").showModal();
      }
      $$("[data-artifact]").forEach(function (button) {
        button.addEventListener("click",function () { state.artifact = button.dataset.artifact; $$("[data-artifact]").forEach(function (item) { item.setAttribute("aria-pressed",String(item === button)); }); renderSwimlane(); });
      });

      setTradeoffProfile("balanced");
      renderCases();
      renderRiskTier();
      renderEvidence();
      renderGrantFields();
      renderCrisis();
      renderControlDemo();
      renderSwimlane();
      window.requestAnimationFrame(function(){fitArchitecture("main");});
    }());
  </script>
</body>
</html>
