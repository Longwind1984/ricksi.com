---
import Glass from '../../../layouts/Glass.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('kb');
  const cogNotes = notes.filter((n: any) => n.data.facet === '认知科学' || n.id.includes('认知科学'));
  
  return cogNotes.map((note: any) => {
    const slug = note.id.split('/').pop();
    return {
      params: { slug },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const { Content } = await render(note);

// 获取分类标签用于显示
const name = note.id.split('/').pop() || '';
let category = '总览';
if (name.startsWith('g')) category = '历史与代际演化';
else if (name.startsWith('a') || name.startsWith('s')) category = '理论底座';
else if (name.startsWith('e') || name.startsWith('r')) category = '前沿应用与案例';
---

<Glass 
  title={`${note.data.title.replace(/^[A-Z0-9_]+ /, '')} · 认知科学百科`}
  description={`认知科学系统化百科：${note.data.title}`}
  active="projects"
  reader
>
  <div class="read-progress" id="read-progress"></div>
  <main class="sub-main">
    <div class="container article-container">
      <article class="sec article">
        <nav class="mono art-crumb">
          <a href="/projects/cognitive-science/">认知科学百科</a>
          <span> / </span>
          <span>{category}</span>
        </nav>
        
        <h1 class="art-title">{note.data.title.replace(/^[A-Z0-9_]+ /, '')}</h1>
        
        <div class="mono art-meta">
          {note.data.created && <span>创建 {note.data.created.toISOString().slice(0, 10)}</span>}
          {note.data.updated && <span>更新 {note.data.updated.toISOString().slice(0, 10)}</span>}
          <span>{category}</span>
        </div>
        
        <div class="prose">
          <Content />
        </div>
      </article>
      
      <aside class="sec art-side">
         <div class="mono wb-label">百科导航</div>
         <div class="nav-links mt-4">
           <a href="/projects/cognitive-science/" class="back-nav">
             <span class="icon">⊞</span> 返回总目录
           </a>
         </div>
         <p class="side-note mt-4">
           本页是认知科学百科的一部分。内容源自知识库的动态生成。
         </p>
      </aside>
    </div>
  </main>
</Glass>

<style>
  .art-crumb {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .art-crumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .art-crumb a:hover {
    color: var(--text);
  }
  .art-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .art-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .art-side {
    position: sticky;
    top: 6rem;
    align-self: start;
    padding: 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .wb-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .nav-links a:hover {
    background: var(--bg-hover);
    border-color: var(--accent);
  }
  .side-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .mt-4 { margin-top: 1rem; }
</style>

<script>
  // 复用现有的进度条逻辑
  const progress = document.getElementById('read-progress');
  if (progress) {
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      progress.style.width = scrolled + '%';
    });
  }
</script>
